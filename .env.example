# .env olarak kopyala ve doldur. .env dosyası git'e girmez.
DB_USERNAME=sinopcepte
DB_PASSWORD=
# İlk açılışta bu bilgilerle bir ADMIN hesabı oluşturulur (yalnız hiç admin yoksa).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# HTTPS arkasında true yapılmalı (oturum çerezi yalnız HTTPS'te gönderilir).
SESSION_COOKIE_SECURE=false
# Makinedeki başka projelerle çakışırsa değiştir.
DB_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000
